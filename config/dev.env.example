# Copy this file to .simplepoint/dev.env and adjust only what differs on your development machine.
CONSUL_HTTP_ADDR=http://127.0.0.1:8500
CONSUL_HTTP_TOKEN=

# Use the installed Gradle for fast local startup without a wrapper download.
# Set this to ./gradlew when you need the repository-pinned Gradle version.
SIMPLEPOINT_GRADLE_EXECUTABLE=gradle

SIMPLEPOINT_POSTGRES_HOST=127.0.0.1
SIMPLEPOINT_POSTGRES_PORT=5432
SIMPLEPOINT_POSTGRES_DATABASE=simplepoint
SIMPLEPOINT_POSTGRES_USERNAME=postgres
SIMPLEPOINT_POSTGRES_PASSWORD=postgres

SIMPLEPOINT_REDIS_HOST=127.0.0.1
SIMPLEPOINT_REDIS_PORT=6379
SIMPLEPOINT_REDIS_PASSWORD=

# Keep idle AI workers lightweight during local development. Enable OCI Runtime
# scheduling only when local runtime nodes are actually running.
SIMPLEPOINT_JPA_SHOW_SQL=false
SIMPLEPOINT_AI_ADAPTIVE_POLLING_ENABLED=true
SIMPLEPOINT_AI_POLLING_MAXIMUM_IDLE_INTERVAL=5s
SIMPLEPOINT_AI_KNOWLEDGE_INDEX_EXECUTION_ENABLED=true
SIMPLEPOINT_TOOL_RUNTIME_SCHEDULING_ENABLED=false

SERVER_PUBLIC_SCHEME=http
SERVER_PUBLIC_HOST=127.0.0.1
SIMPLEPOINT_ADMIN_EMAIL=simplepoint@mail.com
SIMPLEPOINT_ADMIN_PASSWORD=123456
SIMPLEPOINT_TENANT_MANAGER_EMAIL=manager@simplepoint.local
SIMPLEPOINT_TENANT_MANAGER_PASSWORD=123456
SIMPLEPOINT_TENANT_MEMBER_EMAIL=member@simplepoint.local
SIMPLEPOINT_TENANT_MEMBER_PASSWORD=123456

# Development-only secrets. Change them when the machine is shared.
SIMPLEPOINT_SERVICE_CLIENT_SECRET=dev-service-secret
SIMPLEPOINT_AI_CREDENTIAL_ENCRYPTION_KEY=dev-ai-credential-encryption-key-change-me
SIMPLEPOINT_AI_API_KEY_HASH_PEPPER=dev-ai-model-api-key-pepper-change-me
SIMPLEPOINT_MCP_GATEWAY_INTERNAL_TOKEN=dev-mcp-gateway-internal-token-change-me
SIMPLEPOINT_MCP_CAPABILITY_TOKEN_SIGNING_KEY=dev-mcp-capability-signing-key-change-me-32bytes
