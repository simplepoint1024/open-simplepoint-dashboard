{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplepoint.io/schemas/skill-designer-document-v1alpha1.schema.json",
  "title": "SimplePoint Skill Designer Document v1alpha1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "metadata",
    "inputSchema",
    "outputSchema",
    "tools",
    "nodes",
    "ports",
    "edges",
    "tests"
  ],
  "properties": {
    "schemaVersion": {
      "const": "simplepoint.io/designer/v1alpha1"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "inputSchema": {
      "$ref": "#/$defs/objectSchema"
    },
    "outputSchema": {
      "$ref": "#/$defs/objectSchema"
    },
    "tools": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/toolBinding"
      }
    },
    "prompts": {
      "type": ["array", "null"],
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/promptBinding"
      }
    },
    "resources": {
      "type": ["array", "null"],
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/resourceBinding"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 130,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "ports": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "edges": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "workflowOutput": {
      "description": "Declarative output template using exact $ref objects"
    },
    "budgets": {
      "type": ["object", "null"]
    },
    "approvals": {
      "type": ["object", "null"]
    },
    "tests": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/testCase"
      }
    },
    "viewport": {
      "oneOf": [
        {
          "$ref": "#/$defs/viewport"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
        },
        "version": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "maxLength": 128
        },
        "description": {
          "type": "string",
          "maxLength": 512
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "objectSchema": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "toolBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "serverId", "snapshotId", "name"],
      "properties": {
        "alias": {
          "$ref": "#/$defs/alias"
        },
        "serverId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "promptBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "serverId", "snapshotId", "name"],
      "properties": {
        "alias": {
          "$ref": "#/$defs/alias"
        },
        "serverId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "resourceBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/fixedResourceBinding"
        },
        {
          "$ref": "#/$defs/templateResourceBinding"
        }
      ]
    },
    "fixedResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "serverId", "snapshotId", "uri"],
      "properties": {
        "alias": {
          "$ref": "#/$defs/alias"
        },
        "serverId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "templateResourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "serverId", "snapshotId", "uriTemplate"],
      "properties": {
        "alias": {
          "$ref": "#/$defs/alias"
        },
        "serverId": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        },
        "uriTemplate": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$"
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "order",
        "configuration",
        "position"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(__input|__output|[A-Za-z0-9][A-Za-z0-9_.-]{0,63})$"
        },
        "type": {
          "enum": [
            "INPUT",
            "OUTPUT",
            "TOOL",
            "PROMPT",
            "RESOURCE",
            "CONDITION",
            "PARALLEL"
          ]
        },
        "parentNodeId": {
          "type": ["string", "null"]
        },
        "branchId": {
          "type": ["string", "null"]
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "configuration": {
          "type": "object"
        },
        "position": {
          "$ref": "#/$defs/position"
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceNodeId", "targetNodeId"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sourceNodeId": {
          "type": "string"
        },
        "sourceHandle": {
          "type": ["string", "null"]
        },
        "targetNodeId": {
          "type": "string"
        },
        "targetHandle": {
          "type": ["string", "null"]
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodeId",
        "id",
        "direction",
        "kind",
        "required",
        "multiple"
      ],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "direction": {
          "enum": ["INPUT", "OUTPUT"]
        },
        "kind": {
          "enum": ["CONTROL", "DATA"]
        },
        "label": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "required": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        }
      }
    },
    "testCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "enabled",
        "input",
        "mocks",
        "assertions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/alias"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "enabled": {
          "type": "boolean"
        },
        "input": {
          "type": "object"
        },
        "mocks": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/nodeMock"
          }
        },
        "assertions": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/testAssertion"
          }
        }
      }
    },
    "nodeMock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeId", "mode"],
      "properties": {
        "nodeId": {
          "type": "string"
        },
        "mode": {
          "enum": ["SUCCESS", "ERROR"]
        },
        "output": {},
        "errorCode": {
          "type": ["string", "null"],
          "maxLength": 128
        },
        "errorMessage": {
          "type": ["string", "null"],
          "maxLength": 1024
        }
      }
    },
    "testAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "sourceNodeId", "fieldPath", "operator"],
      "properties": {
        "id": {
          "$ref": "#/$defs/alias"
        },
        "sourceNodeId": {
          "type": "string"
        },
        "fieldPath": {
          "type": "string",
          "maxLength": 512
        },
        "operator": {
          "enum": [
            "EQUALS",
            "NOT_EQUALS",
            "EXISTS",
            "NOT_EXISTS",
            "CONTAINS",
            "MATCHES"
          ]
        },
        "expected": {}
      }
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "viewport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "zoom"],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "zoom": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  }
}
