  "artifactProbe": {
    "source": "import java.util.*;\nimport org.simplepoint.platform.installation.*;\nimport org.simplepoint.platform.installation.jdbc.*;\nimport org.simplepoint.platform.installation.dictionary.DictionaryAdoptionInstallation;\nimport org.simplepoint.platform.bootstrap.registry.migration.BootstrapLegacyTransfer;\nimport org.simplepoint.platform.bootstrap.registry.migration.BootstrapLegacyTransfers;\nimport org.simplepoint.plugin.rbac.tenant.service.initialize.DictionaryLegacyAdoptions;\nimport org.simplepoint.platform.dictionary.registration.DictionaryRegistrationService;\nimport org.simplepoint.platform.composition.ModuleCatalog;\nimport org.simplepoint.remoting.RemoteProvider;\nimport org.springframework.transaction.annotation.Transactional;\n\npublic class VerifyInstallationArtifacts {\n  public static void main(String[] args) throws Exception {\n    var loader = VerifyInstallationArtifacts.class.getClassLoader();\n    for (Class<?> type : List.of(InstallationRunner.class, JdbcInstallationJournal.class,\n        DictionaryAdoptionInstallation.class, BootstrapLegacyTransfers.class,\n        DictionaryLegacyAdoptions.class)) {\n      if (Collections.list(loader.getResources(type.getName().replace('.', '/') + \".class\")).size() != 1)\n        throw new AssertionError(\"Missing/duplicate artifact: \" + type.getName());\n      if (type.isAnnotationPresent(RemoteProvider.class))\n        throw new AssertionError(\"Installer API exposed as RPC\");\n    }\n    var source = BootstrapLegacyTransfers.class.getMethod(\"findCompletion\", BootstrapLegacyTransfer.Identity.class);\n    var target = DictionaryLegacyAdoptions.class.getMethod(\"findCompletion\", String.class);\n    for (var method : List.of(source, target)) {\n      var tx = method.getAnnotation(Transactional.class);\n      if (tx == null || !tx.readOnly()) throw new AssertionError(\"Receipt lookup must be read-only\");\n    }\n    if (DictionaryRegistrationService.class.getDeclaredMethods().length != 1\n        || !DictionaryRegistrationService.class.getDeclaredMethods()[0].getName().equals(\"apply\"))\n      throw new AssertionError(\"Runtime registration contract widened\");\n    var migrations = InstallationJournalMigrations.plan(\"journal\");\n    if (migrations.schemas().size() != 1 || !migrations.undeclaredModules().isEmpty())\n      throw new AssertionError(\"Unexpected journal schema plan\");\n    var schema = migrations.schemas().getFirst();\n    if (!schema.module().equals(\"installation-journal\") || !schema.store().equals(\"journal\")\n        || !new HashSet<>(schema.tables()).equals(Set.of(\"simpoint_installation_targets\",\n            \"simpoint_installation_operations\", \"simpoint_installation_steps\", \"simpoint_installation_attempts\")))\n      throw new AssertionError(\"Journal ownership changed\");\n    String path = \"META-INF/simplepoint/modules/installation-journal/db/\";\n    for (String asset : List.of(\"manifest.properties\", \"postgresql/V1__installation_journal.sql\"))\n      if (Collections.list(loader.getResources(path + asset)).size() != 1)\n        throw new AssertionError(\"Missing/duplicate migration asset\");\n    var plan = ModuleCatalog.discover(loader).plan(List.of(\"identity\"));\n    if (!\"identity\".equals(plan.capabilityOwners().get(\"security.dictionary-registration:1\")))\n      throw new AssertionError(\"Runtime dictionary owner changed\");\n    System.out.println(\"Verified built installer libraries plus installed Common domain providers: unique classes, four declared journal tables, unique V1 assets, local read-only receipts, unchanged narrow runtime RPC and dictionary owner. Installer libraries are separate artifacts, not a deployed installation host.\");\n  }\n}\n",
    "command": "/home/ymsl/.jdks/ms-21.0.12.1/bin/java --class-path 'simplepoint-services/simplepoint-service-common/build/install/simplepoint-service-common/lib/*:simplepoint-platform/simplepoint-platform-installation/build/libs/*:simplepoint-platform/simplepoint-platform-installation-jdbc/build/libs/*:simplepoint-platform/simplepoint-platform-installation-dictionary/build/libs/*:simplepoint-data/simplepoint-data-migrations-api/build/libs/*' /tmp/VerifyInstallationArtifacts.java",
    "output": "Verified built installer libraries plus installed Common domain providers: unique classes, four declared journal tables, unique V1 assets, local read-only receipts, unchanged narrow runtime RPC and dictionary owner. Installer libraries are separate artifacts, not a deployed installation host.\n"
