    "captureSource": "import java.lang.reflect.Proxy;\nimport java.nio.file.Files;\nimport java.nio.file.Path;\nimport java.util.*;\nimport com.fasterxml.jackson.databind.ObjectMapper;\nimport org.simplepoint.platform.bootstrap.PlatformBootstrapContribution;\nimport org.simplepoint.plugin.rbac.tenant.api.entity.Dictionary;\nimport org.simplepoint.plugin.rbac.tenant.api.entity.DictionaryItem;\nimport org.simplepoint.plugin.rbac.tenant.api.service.DictionaryService;\nimport org.simplepoint.plugin.rbac.tenant.api.service.DictionaryItemService;\n\npublic class CaptureLegacyDictionarySeeds {\n  public static void main(String[] args) throws Exception {\n    var output = new ArrayList<Map<String,Object>>();\n    for (String[] entry : List.of(\n        new String[]{\"ExternalIdentityProviderDictionaryInitializer\", \"externalIdentityProviderDictionaryContribution\"},\n        new String[]{\"NotificationDictionaryInitializer\", \"notificationDictionaryBootstrapContribution\"})) {\n      var dictionaries = new ArrayList<Dictionary>();\n      var items = new ArrayList<DictionaryItem>();\n      var loader = CaptureLegacyDictionarySeeds.class.getClassLoader();\n      var dictionariesService = (DictionaryService) Proxy.newProxyInstance(loader, new Class<?>[]{DictionaryService.class},\n          (proxy, method, values) -> {\n            if (method.getName().equals(\"findAll\")) return List.of();\n            if (method.getName().equals(\"create\")) { dictionaries.add((Dictionary) values[0]); return values[0]; }\n            throw new AssertionError(method.getName());\n          });\n      var itemService = (DictionaryItemService) Proxy.newProxyInstance(loader, new Class<?>[]{DictionaryItemService.class},\n          (proxy, method, values) -> {\n            if (method.getName().equals(\"findAll\")) return List.of();\n            if (method.getName().equals(\"create\")) { items.add((DictionaryItem) values[0]); return values[0]; }\n            throw new AssertionError(method.getName());\n          });\n      var type = Class.forName(\"org.simplepoint.common.server.initialize.\" + entry[0]);\n      var factory = (PlatformBootstrapContribution) type.getMethod(entry[1], DictionaryService.class, DictionaryItemService.class)\n          .invoke(type.getConstructor().newInstance(), dictionariesService, itemService);\n      var contribution = factory.contribution();\n      contribution.action().run();\n      var record = new LinkedHashMap<String,Object>();\n      record.put(\"moduleCode\", contribution.moduleCode());\n      record.put(\"contributionKey\", contribution.contributionKey());\n      record.put(\"version\", contribution.version());\n      record.put(\"order\", contribution.order());\n      record.put(\"checksum\", contribution.checksum());\n      record.put(\"dictionaries\", dictionaries.stream().map(d -> Map.of(\n          \"code\", d.getCode(), \"name\", d.getName(), \"description\", d.getDescription(), \"sort\", d.getSort(),\n          \"items\", items.stream().filter(i -> i.getDictionaryCode().equals(d.getCode())).map(i -> Map.of(\n            \"value\",i.getValue(),\"name\",i.getName(),\"i18nKey\",i.getI18nKey(),\"description\",i.getDescription(),\"sort\",i.getSort())).toList())).toList());\n      output.add(record);\n    }\n    Files.writeString(Path.of(args[0]), new ObjectMapper().writerWithDefaultPrettyPrinter().writeValueAsString(output)+\"\\n\");\n  }\n}\n",
