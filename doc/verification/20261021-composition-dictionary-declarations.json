    "source": "import java.nio.file.*;\nimport java.util.*;\nimport org.simplepoint.platform.composition.*;\nimport org.simplepoint.platform.dictionary.*;\n\npublic class VerifyDictionaryArtifacts {\n  public static void main(String[] args) throws Exception {\n    var loader = VerifyDictionaryArtifacts.class.getClassLoader();\n    var catalog = ModuleCatalog.discover(loader);\n    var selected = catalog.plan(List.of(\"oidc\", \"notification\"));\n    var declarations = ModuleDictionaryPlan.declarations(selected);\n    if (!declarations.keySet().equals(Set.of(\"oidc\", \"notification\")))\n      throw new AssertionError(\"Missing selected declarations\");\n    if (!ModuleDictionaryPlan.declarations(catalog.plan(List.of(\"identity\"))).isEmpty())\n      throw new AssertionError(\"Unselected dictionaries were discovered\");\n    var codes = new HashSet<String>();\n    int items = 0;\n    for (var declaration : declarations.values()) {\n      for (var dictionary : declaration.dictionaries()) {\n        if (!codes.add(dictionary.code())) throw new AssertionError(\"Duplicate code\");\n        items += dictionary.items().size();\n      }\n    }\n    if (codes.size() != 8 || items != 27) throw new AssertionError(\"Incorrect metadata count\");\n    for (String name : List.of(\n        \"org.simplepoint.platform.dictionary.DictionaryContribution\",\n        \"org.simplepoint.plugin.oidc.api.initialization.ExternalIdentityProviderDictionaries\",\n        \"org.simplepoint.plugin.notification.api.initialization.NotificationDictionaries\")) {\n      var urls = Collections.list(loader.getResources(name.replace('.', '/') + \".class\"));\n      if (urls.size() != 1) throw new AssertionError(\"Duplicate or missing packaged class: \" + name);\n    }\n    System.out.println(\"Installed artifact: two selected dictionary owners, eight dictionaries, 27 items; identity-only plan excludes both; metadata classes packaged once.\");\n  }\n}\n",
