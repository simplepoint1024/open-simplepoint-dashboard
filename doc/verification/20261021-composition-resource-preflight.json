  "checkstyleInitScript": "import org.gradle.api.plugins.quality.Checkstyle\n\ngradle.projectsEvaluated {\n    def root = gradle.rootProject\n    def paths = new File('/tmp/simplepoint-resource-preflight-style-files.txt').readLines().collect { root.file(it) }\n    def checks = []\n    root.allprojects.each { p ->\n        def sources = paths.findAll { it.toPath().startsWith(p.projectDir.toPath().resolve('src')) }\n        if (!sources.isEmpty()) {\n            checks.add(p.tasks.register('checkstyleResourcePreflight', Checkstyle) {\n                source sources\n                classpath = p.sourceSets.test.compileClasspath\n                configFile = root.file('checkstyle/google_checks.xml')\n                maxWarnings = 0\n                reports {\n                    xml.required = true\n                    html.required = true\n                }\n            })\n        }\n    }\n    root.tasks.register('verifyResourcePreflightStyle') { dependsOn checks }\n}\n",
  "commands": [
    "JAVA_HOME=/home/ymsl/.jdks/ms-21.0.12.1 ./gradlew -I /tmp/simplepoint-resource-preflight-checkstyle.gradle :simplepoint-security:simplepoint-security-core:test :simplepoint-plugins:simplepoint-plugins-rbac:simplepoint-plugin-rbac-router-api:test :simplepoint-plugins:simplepoint-plugins-rbac:simplepoint-plugin-rbac-router-implementation:test :simplepoint-platform:simplepoint-platform-composition-spring:test :simplepoint-services:simplepoint-service-common:test verifyResourcePreflightStyle verifyModuleBoundaries -Psimplepoint.frontend.skip=true --console=plain",
    "With isolated SP_RESOURCE_TEST_POSTGRES_URL and external test password: ./gradlew :simplepoint-plugins:simplepoint-plugins-rbac:simplepoint-plugin-rbac-router-implementation:test --tests *ResourceRegistrationTransactionTest -Psimplepoint.frontend.skip=true --console=plain",
    "In simplepoint-react: pnpm i18n:sync; pnpm i18n:check; pnpm typecheck",
    "git diff --check -- <scoped files>"
  ],
  "verifiedScenarios": [
    "Code and path ownership checked independently, including null/blank legacy owners; two declarations cannot claim one stored identity",
    "Same-owner path-based code rename preserves record identity and omitted permission metadata; caller DTOs remain unchanged",
    "Full tree validation before resource/grant effects: duplicate identities, inherited scopes, retained physical parent references, cycles, nulls, depth and count bounds",
    "Foreign descendants cannot be retired, moved or have their ancestor scopes changed by a snapshot from another owner",
    "Stale closure rows cannot cause retention or ownership violations during retirement",
    "Real JPA repositories and Spring service transaction advice on H2 and PostgreSQL verify rename, retired child deletion, ancestor row cleanup, unaffected foreign resources and rollback of earlier writes after late rejection",
