  "artifactProbe": {
    "source": "import java.util.*;\nimport org.simplepoint.platform.bootstrap.service.PlatformContributionService;\nimport org.simplepoint.platform.bootstrap.registry.migration.BootstrapLegacyTransfers;\nimport org.simplepoint.platform.bootstrap.registry.migration.BootstrapLegacyTransfer;\nimport org.simplepoint.platform.bootstrap.registry.migration.BootstrapRegistryWriteBoundary;\nimport org.simplepoint.platform.bootstrap.registry.service.impl.PlatformContributionServiceImpl;\nimport org.simplepoint.platform.composition.ModuleCatalog;\nimport org.simplepoint.remoting.RemoteProvider;\nimport org.springframework.transaction.annotation.Transactional;\n\npublic class VerifyBootstrapTransferArtifacts {\n  public static void main(String[] args) throws Exception {\n    var loader = VerifyBootstrapTransferArtifacts.class.getClassLoader();\n    var plan = ModuleCatalog.discover(loader).plan(List.of(\"bootstrap-registry\"));\n    if (!\"bootstrap-registry\".equals(plan.capabilityOwners().get(\"platform.contribution:1\")))\n      throw new AssertionError(\"Registry provider ownership changed\");\n    for (var method : PlatformContributionService.class.getMethods()) {\n      if (Set.of(\"preview\", \"transfer\", \"requireScope\").contains(method.getName()))\n        throw new AssertionError(\"Installer method exposed remotely\");\n    }\n    if (BootstrapLegacyTransfers.class.isAnnotationPresent(RemoteProvider.class))\n      throw new AssertionError(\"Transfer service is a remote provider\");\n    if (BootstrapLegacyTransfers.class.getMethod(\"transfer\", BootstrapLegacyTransfer.Command.class).getAnnotation(Transactional.class) == null)\n      throw new AssertionError(\"Transfer has no transaction\");\n    if (PlatformContributionServiceImpl.class.getConstructors()[0].getParameterCount() != 3)\n      throw new AssertionError(\"Runtime provider is not wired to transfer guard and mutation boundary\");\n    for (Class<?> type : List.of(BootstrapLegacyTransfers.class, BootstrapRegistryWriteBoundary.class, PlatformContributionServiceImpl.class)) {\n      if (Collections.list(loader.getResources(type.getName().replace('.', '/') + \".class\")).size() != 1)\n        throw new AssertionError(\"Duplicate or missing registry implementation\");\n    }\n    var path = \"META-INF/simplepoint/modules/bootstrap-registry/db/\";\n    if (Collections.list(loader.getResources(path + \"postgresql/V2__legacy_contribution_transfers.sql\")).size() != 1)\n      throw new AssertionError(\"Missing or duplicate V2 migration\");\n    try (var stream = loader.getResourceAsStream(path + \"manifest.properties\")) {\n      var properties = new Properties(); properties.load(stream);\n      if (!properties.getProperty(\"migrations\").contains(\"V2__legacy_contribution_transfers.sql\")\n          || !properties.getProperty(\"tables\").contains(\"simpoint_bootstrap_registry_revision\")\n          || !properties.getProperty(\"tables\").contains(\"simpoint_bootstrap_legacy_transfers\"))\n        throw new AssertionError(\"Incomplete registry migration declaration\");\n    }\n    System.out.println(\"Installed Common distribution: registry-owned local installer transfer, narrow existing RPC, runtime transfer guard/shared write boundary, atomic transfer annotation and unique declared V2 migration verified.\");\n  }\n}\n",
    "command": "/home/ymsl/.jdks/ms-21.0.12.1/bin/java --class-path 'simplepoint-services/simplepoint-service-common/build/install/simplepoint-service-common/lib/*' /tmp/VerifyBootstrapTransferArtifacts.java",
    "output": "Installed Common distribution: registry-owned local installer transfer, narrow existing RPC, runtime transfer guard/shared write boundary, atomic transfer annotation and unique declared V2 migration verified.\n"
